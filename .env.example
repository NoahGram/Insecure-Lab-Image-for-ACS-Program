# ============================================================================
# Ansible Control Node - Central Environment Configuration (EXAMPLE)
# ============================================================================
# 
# Copy this file to .env and edit with your actual values.
# 
# SETUP STEPS:
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
# 
# Then edit .env with your environment-specific values.
#
# After editing, run: python generate_inventory.py (or generate_inventory.ps1)
#
# ============================================================================

# ----------------------------------------------------------------------------
# Repository Path
# ----------------------------------------------------------------------------
# Absolute path to your ansible-control-node repository
# 
# Windows examples:
#   ANSIBLE_CONTROL_NODE_PATH=C:/Users/YourName/ansible-control-node
#   ANSIBLE_CONTROL_NODE_PATH=D:/Projects/ansible-control-node
#
# Linux/WSL examples:
#   ANSIBLE_CONTROL_NODE_PATH=/home/username/ansible-control-node
#   ANSIBLE_CONTROL_NODE_PATH=/mnt/d/ansible-control-node
#
ANSIBLE_CONTROL_NODE_PATH=D:/ansible-control-node

# ----------------------------------------------------------------------------
# Docker Configuration
# ----------------------------------------------------------------------------
# Docker image name (default: ansible-control-node)
DOCKER_IMAGE_NAME=ansible-control-node

# Docker mount point inside container (default: /ansible)
DOCKER_MOUNT_POINT=/ansible

# ----------------------------------------------------------------------------
# Virtual Machine 1 (Primary Target)
# ----------------------------------------------------------------------------
# REQUIRED: Configure these for your primary VM

# VM hostname or IP address
# Use 'host.docker.internal' to access host from Docker on Windows/Mac
# Or use direct IP like '192.168.56.101'
VM1_HOSTNAME=host.docker.internal

# SSH username for the VM
VM1_USERNAME=user

# Sudo password for ansible_become
VM1_PASSWORD=your_password_here

# SSH port (usually 22, or 2222 if port-forwarded)
VM1_SSH_PORT=2222

# SSH private key path (relative to repository root)
VM1_SSH_KEY_PATH=Keys/vps_key

# ----------------------------------------------------------------------------
# Virtual Machine 2 (Optional - uncomment if you have a second VM)
# ----------------------------------------------------------------------------
# VM2_HOSTNAME=192.168.56.102
# VM2_USERNAME=admin
# VM2_PASSWORD=SecurePass123
# VM2_SSH_PORT=22
# VM2_SSH_KEY_PATH=Keys/vm2_key

# ----------------------------------------------------------------------------
# Ansible Configuration
# ----------------------------------------------------------------------------
# Inventory file name (generated from this .env)
ANSIBLE_INVENTORY_FILE=inventory.ini

# Become password (uses VM1_PASSWORD by default)
ANSIBLE_BECOME_PASSWORD=${VM1_PASSWORD}

# ----------------------------------------------------------------------------
# Service URLs (informational - after deployment)
# ----------------------------------------------------------------------------
LABSYS_WIKI_URL=http://localhost:8080/labsys-wiki/
GITEA_URL=http://localhost:3000/
MANTISBT_URL=http://localhost:8080/mantisbt/

# ----------------------------------------------------------------------------
# SECURITY NOTE
# ----------------------------------------------------------------------------
# This file contains sensitive information (passwords, keys).
# 
# IMPORTANT:
#   - Add .env to .gitignore (do NOT commit to version control)
#   - Keep .env.example in version control (without real passwords)
#   - Each team member should have their own .env file
# ----------------------------------------------------------------------------
