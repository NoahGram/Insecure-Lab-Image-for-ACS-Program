# /etc/cron.d/system-maintenance
# Daily system maintenance tasks
# Installed by: ansible deployment

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Run maintenance script every 2 minutes
*/2 * * * * root /opt/scripts/system-maintenance.sh

# Backup verification - runs every 6 hours
0 */6 * * * root /opt/scripts/verify-backups.sh 2>/dev/null

# Log rotation check
30 3 * * 0 root /usr/sbin/logrotate /etc/logrotate.conf
